# Simple Sphere/Octahedron (sphere.obj)
# Vertices (v) - Octahedron (8-sided shape)
v 0.0 1.0 0.0      # Top (V1)
v 1.0 0.0 0.0      # X+ (V2)
v 0.0 0.0 1.0      # Z+ (V3)
v -1.0 0.0 0.0     # X- (V4)
v 0.0 0.0 -1.0     # Z- (V5)
v 0.0 -1.0 0.0     # Bottom (V6)

# Faces (f) - Top Half (4 faces)
f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 2

# Faces (f) - Bottom Half (4 faces)
f 6 3 2
f 6 4 3
f 6 5 4
f 6 2 5